# Copy to .env (git-ignored). The harness loads it automatically; shell exports win.
# Never commit real keys.

# Option A: one OpenRouter key drives both --driver claude and --driver openai.
OPENROUTER_API_KEY=

# Option B: direct vendor keys (used only when OPENROUTER_API_KEY is empty).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Route override per driver: direct | openrouter (default when OPENROUTER_API_KEY is set)
# --driver openai also accepts "gemini": Google's OpenAI-compatible endpoint, GEMINI_API_KEY.
# HARNESS_CLAUDE_VIA=openrouter
# HARNESS_OPENAI_VIA=gemini
# GEMINI_API_KEY=
# HARNESS_OPENAI_MODEL=gemini-3.8-flash

# Optional model overrides. With OpenRouter use vendor/model ids:
# HARNESS_CLAUDE_MODEL=anthropic/claude-sonnet-5.5
# HARNESS_OPENAI_MODEL=openai/gpt-5.5
#
# Zero-credit testing: free OpenRouter models that passed a tool-calling probe through
# both adapters (2026-10-06). Free tier is rate-limited (~20 req/min, ~50 req/day).
# HARNESS_CLAUDE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# HARNESS_OPENAI_MODEL=cohere/north-mini-code:free
# Direct defaults: claude-sonnet-5-5 / gpt-5.5
